# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id-here

# Optional: restrict slash-command registration to one guild for instant updates
# during development. Leave empty to register commands globally (takes up to 1h
# to propagate).
DISCORD_GUILD_ID=

# Prefix for text-based commands: <prefix>p <url>, <prefix>skip,
# <prefix>loop <off|song|queue>, <prefix>leave, <prefix>list.
# Requires the "Message Content Intent" toggle to be enabled for this bot
# in the Discord Developer Portal (Bot tab).
COMMAND_PREFIX=b!

# Absolute or relative path to the yt-dlp / youtube-dl binary. Leave empty to
# use the binary that youtube-dl-exec downloads automatically.
YOUTUBE_DL_BINARY_PATH=

# Extra space-separated flags appended to every yt-dlp invocation. Useful for
# --js-runtimes node --remote-components ejs:github (required by YouTube's
# current JS-challenge requirements) or --cookies /path/to/cookies.txt.
YT_DLP_EXTRA_ARGS=--js-runtimes node --remote-components ejs:github

# Directory used for the download -> play -> delete cycle.
TEMP_DIR=./temp

# Max number of songs the pre-fetcher is allowed to keep downloaded at once
# (current song + this many ahead). Keep this small; the architecture is
# designed around "one song ahead", not a bulk cache.
PREFETCH_AHEAD=1

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
