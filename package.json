{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "A stability-first Discord music bot using a download -> play -> delete architecture with pre-fetching.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy-commands": "node dist/deployCommands.js",
    "deploy-commands:dev": "tsx src/deployCommands.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.10",
    "discord.js": "^14.25.1",
    "dotenv": "^17.0.0",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "youtube-dl-exec": "^3.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
